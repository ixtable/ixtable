# ixtable Cloud Edge Function secrets. Copy of the variable list only.
# Local: `node scripts/cloud/dev-secrets.mjs` writes real throwaway values to
# supabase/functions/.env.local (and .env, which `supabase start` loads).
# Hosted: `supabase secrets set --env-file <file>` with production values
# held in the secret manager. Never commit real values.

# Ed25519 bundle-signing private key, PKCS8 DER base64.
IXTABLE_CLOUD_SIGNING_KEY=
# Matching public key, SPKI DER base64. Desktop dev/test override for the
# pinned key; the raw 32-byte key is the last 32 bytes of the DER.
IXTABLE_CLOUD_PUBLIC_KEY=
IXTABLE_CLOUD_PUBLIC_KEY_RAW=
# Key-encryption keys for credential envelopes: 32 random bytes base64 each.
# Add IXTABLE_KEK_V2 and bump IXTABLE_KEK_CURRENT_VERSION to rotate.
IXTABLE_KEK_V1=
IXTABLE_KEK_CURRENT_VERSION=1
# HMAC secret for bundle fingerprints and audit IP hashes (32 random bytes base64).
IXTABLE_FINGERPRINT_SECRET=
# Billing: "stripe" (STRIPE_SECRET_KEY required) or "fake" (local/QA only;
# the fake provider and billing-fake-complete also need IXTABLE_ALLOW_FAKE_BILLING=1).
BILLING_PROVIDER=fake
IXTABLE_ALLOW_FAKE_BILLING=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_test_
# Public API origin for signed storage URLs (required when hosted; local
# default http://127.0.0.1:54321). Never derived from request headers.
IXTABLE_PUBLIC_API_URL=
# "production" turns on production-only guards (e.g. invitations-accept
# refuses while email confirmations are off). See docs/ops/production-config.md.
IXTABLE_ENV=
# Website origin (CORS, checkout and invitation links).
SITE_URL=http://127.0.0.1:3001
# Extra comma-separated CORS origins.
CORS_ALLOWED_ORIGINS=
IXTABLE_CLOUD_VERSION=0.1.0
