{
  "name": "ixtable",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "pretest": "cd src-tauri && RUSTC_WRAPPER= cargo build --lib && cp target/index.js target/index.cjs",
    "test": "vitest run",
    "screenshot:css": "npm run build && node scripts/screenshot/build-css.mjs",
    "prescreenshot": "npm run pretest",
    "screenshot": "npm run screenshot:css && vitest run --config vitest.screenshot.config.ts",
    "preservice-qa": "npm run pretest",
    "service-qa": "vitest run --config vitest.service-qa.config.ts",
    "web-qa": "npm run test:web-qa --prefix web"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react-swc": "^4.0.1",
    "jsdom": "^26.1.0",
    "playwright": "^1.55.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.8.3",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
